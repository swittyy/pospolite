---
import SiteLayout from "../layouts/SiteLayout.astro";
import { categories } from "../data/catalog";
const apiBase = import.meta.env.PUBLIC_API_URL ?? "";
---
<SiteLayout title="Админ-панель — POSPOLITE" description="Управление каталогом POSPOLITE.">
  <main class="admin-shell" data-api-base={apiBase} data-initial-catalog={JSON.stringify({ categories })}>
    <header class="admin-top"><a class="wordmark" href={import.meta.env.BASE_URL}>POSPOLITE<span class="wordmark-mark">®</span></a><span>CONTROL PANEL / 001</span><a href={import.meta.env.BASE_URL}>НА САЙТ ↗</a></header>
    <section class="admin-intro"><p class="eyebrow">POSPOLITE / MANAGEMENT</p><h1>УПРАВЛЕНИЕ<span>.</span></h1><p>Каталог, цены и наличие — в одном месте.</p></section>
    <section class="admin-login" id="login-panel">
      <div><span class="admin-label">01 / AUTHENTICATION</span><h2>ВХОД В СИСТЕМУ</h2><p>Введи секретный токен, заданный на сервере POSPOLITE API.</p></div>
      <form id="login-form"><label for="api-url">API endpoint</label><input id="api-url" type="url" placeholder="https://api.example.com" value={apiBase} required /><label for="admin-token">Секретный токен</label><input id="admin-token" type="password" autocomplete="current-password" placeholder="Токен администратора" required /><button type="submit">ВОЙТИ <span>↗</span></button><p class="admin-message" id="login-message" role="status"></p></form>
    </section>
    <section class="admin-workspace" id="workspace" hidden>
      <div class="admin-toolbar"><div><span class="admin-label">02 / OVERVIEW</span><h2>КАТАЛОГ</h2></div><div class="admin-actions"><span id="catalog-count"></span><button class="admin-secondary" id="refresh-button" type="button">ОБНОВИТЬ ↻</button><button class="admin-secondary" id="logout-button" type="button">ВЫЙТИ</button></div></div>
      <div class="admin-stats"><article><span>КАТЕГОРИИ</span><strong id="stat-categories">—</strong></article><article><span>ПОЗИЦИИ</span><strong id="stat-products">—</strong></article><article><span>НАЛИЧИЕ НЕ УКАЗАНО</span><strong id="stat-unknown">—</strong></article></div>
      <div class="admin-columns">
        <aside class="admin-categories"><div class="admin-subhead"><span>КАТЕГОРИИ</span><button id="add-category-button" type="button" aria-label="Добавить категорию">＋</button></div><div id="category-list"></div></aside>
        <section class="admin-editor"><div class="admin-subhead"><span id="selected-category-label">ВЫБЕРИ КАТЕГОРИЮ</span><button id="save-button" type="button">СОХРАНИТЬ ИЗМЕНЕНИЯ ↗</button></div><div id="category-editor"></div><div id="product-list"></div><button class="admin-add-product" id="add-product-button" type="button">＋ ДОБАВИТЬ ТОВАР</button><p class="admin-message" id="save-message" role="status"></p></section>
      </div>
      <p class="admin-footnote" id="admin-mode-note">Изменения сохраняются на сервере API. Не публикуй токен и не передавай его посетителям сайта.</p>
    </section>
    <footer class="admin-footer"><span>POSPOLITE ADMIN / PRIVATE ACCESS</span><span>BUILD WITH CARE.</span></footer>
  </main>
</SiteLayout>
<style>
:root{--adm-bg:#0a0a0a;--adm-panel:#111;--adm-panel2:#171717;--adm-line:#292929;--adm-text:#f4f4f0;--adm-muted:#858585;--adm-accent:#d8ff55;--adm-radius:18px}
body{background:var(--adm-bg)!important}
.admin-shell{position:relative;isolation:isolate;min-height:100vh;padding:0 clamp(18px,4vw,64px);background:radial-gradient(ellipse at 78% 0%,rgba(216,255,85,.075),transparent 34%),var(--adm-bg);color:var(--adm-text);font-family:Manrope,sans-serif;overflow:hidden}
.admin-shell:before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.15;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(to bottom,black,transparent 75%)}
.admin-top{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--adm-line);font:10px "DM Mono",monospace;letter-spacing:.08em;position:relative}
.wordmark{font:800 20px Manrope,sans-serif;letter-spacing:-.09em;color:var(--adm-text)!important}.wordmark-mark{font:9px "DM Mono";vertical-align:top;margin-left:4px;color:var(--adm-accent)}
.admin-top>span{color:var(--adm-muted)}.admin-top>a:last-child{color:var(--adm-text);padding:10px 14px;border:1px solid var(--adm-line);border-radius:999px;transition:.25s}.admin-top>a:last-child:hover{background:var(--adm-accent);color:#090909;border-color:var(--adm-accent);transform:translateY(-2px)}
.admin-intro{padding:clamp(54px,8vw,104px) 0 42px;border-bottom:1px solid var(--adm-line);position:relative}
.admin-intro .eyebrow,.admin-label{font:10px "DM Mono",monospace;letter-spacing:.14em;color:var(--adm-muted)}
.admin-intro .eyebrow:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--adm-accent);margin:0 10px 1px 0;box-shadow:0 0 14px var(--adm-accent)}
.admin-intro h1{margin:24px 0 14px;font-size:clamp(54px,10vw,124px);font-weight:800;letter-spacing:-.095em;line-height:.86}.admin-intro h1 span{color:var(--adm-accent)}
.admin-intro>p:last-child{color:#aaa;font-size:14px;letter-spacing:-.02em}
.admin-intro:after{content:"P /";position:absolute;right:2%;bottom:18px;font:800 clamp(76px,15vw,190px)/.8 Manrope,sans-serif;letter-spacing:-.13em;color:rgba(255,255,255,.035);pointer-events:none}
.admin-login{max-width:1040px;margin:44px auto;display:grid;grid-template-columns:1fr minmax(300px,440px);gap:52px;padding:34px;border:1px solid var(--adm-line);border-radius:var(--adm-radius);background:linear-gradient(135deg,#151515,#0e0e0e);box-shadow:0 24px 90px #0008}
.admin-login h2,.admin-toolbar h2{font-size:clamp(26px,4vw,42px);letter-spacing:-.07em;margin:18px 0 8px;font-weight:800}.admin-login p{font-size:12px;color:var(--adm-muted);line-height:1.8}
.admin-login form{display:flex;flex-direction:column;gap:9px}.admin-login label,.product-form label,.category-form label{font:9px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.06em;margin-top:8px}
.admin-login input,.product-form input,.category-form input,.category-form textarea{width:100%;padding:14px 15px;border:1px solid var(--adm-line);background:#090909;color:var(--adm-text);font:12px "DM Mono",monospace;border-radius:10px;outline:none;transition:border .2s,box-shadow .2s}
.admin-login input:focus,.product-form input:focus,.category-form input:focus,.category-form textarea:focus{border-color:var(--adm-accent);box-shadow:0 0 0 3px #d8ff5518}
.admin-login button,.admin-subhead button,.admin-add-product{border:1px solid var(--adm-accent);background:var(--adm-accent);color:#090909;padding:14px 18px;font:700 10px "DM Mono",monospace;letter-spacing:.05em;cursor:pointer;border-radius:10px;transition:transform .2s,box-shadow .2s,background .2s}
.admin-login button:hover,.admin-subhead button:hover,.admin-add-product:hover{transform:translateY(-2px);box-shadow:0 8px 24px #d8ff5522}
.admin-workspace{padding:46px 0 54px;animation:admin-enter .55s cubic-bezier(.2,.8,.2,1) both}
@keyframes admin-enter{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.admin-toolbar{display:flex;justify-content:space-between;align-items:end;gap:20px}.admin-toolbar h2{font-size:clamp(32px,5vw,54px);margin:10px 0 0}
.admin-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.admin-actions>span{font:9px "DM Mono",monospace;color:var(--adm-muted);margin-right:8px}
.admin-secondary{padding:11px 14px;background:#111;color:var(--adm-text);border:1px solid var(--adm-line);font:9px "DM Mono",monospace;cursor:pointer;border-radius:9px;transition:.2s}
.admin-secondary:hover{border-color:var(--adm-accent);color:var(--adm-accent);transform:translateY(-2px)}
.admin-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:30px 0}
.admin-stats article{position:relative;overflow:hidden;padding:22px 24px;background:linear-gradient(145deg,#171717,#101010);border:1px solid var(--adm-line);border-radius:14px;transition:transform .25s,border-color .25s}
.admin-stats article:hover{transform:translateY(-4px);border-color:#555}.admin-stats article:after{content:"";position:absolute;width:90px;height:90px;right:-30px;bottom:-44px;border:1px solid #ffffff12;border-radius:50%;box-shadow:0 0 0 14px #ffffff05,0 0 0 28px #ffffff03}
.admin-stats span{display:block;font:9px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.1em}.admin-stats strong{display:block;margin-top:15px;font:500 42px "DM Mono",monospace;letter-spacing:-.08em;color:var(--adm-text)}#stat-unknown{color:var(--adm-accent)}
.admin-columns{display:grid;grid-template-columns:260px minmax(0,1fr);gap:14px;align-items:start}
.admin-categories,.admin-editor{border:1px solid var(--adm-line);background:linear-gradient(145deg,#141414,#0e0e0e);padding:20px;border-radius:14px;min-width:0}
.admin-categories{position:sticky;top:18px}.admin-subhead{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:16px;border-bottom:1px solid var(--adm-line);font:9px "DM Mono",monospace;letter-spacing:.1em;color:var(--adm-muted)}
.admin-subhead button{padding:9px 12px;border-radius:8px}
.category-choice{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:14px 12px;border:0;border-bottom:1px solid #ffffff0a;background:transparent;color:#bcbcbc;text-align:left;font:11px Manrope,sans-serif;cursor:pointer;border-radius:8px;transition:.2s}
.category-choice:after{content:"↗";opacity:0;transform:translateX(-4px);transition:.2s;color:var(--adm-accent)}
.category-choice:hover,.category-choice[aria-current=true]{background:#ffffff08;color:#fff}.category-choice[aria-current=true]{box-shadow:inset 2px 0 var(--adm-accent);padding-left:16px}.category-choice[aria-current=true]:after,.category-choice:hover:after{opacity:1;transform:translateX(0)}
.category-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px 0;border-bottom:1px solid var(--adm-line)}
.category-form label{display:flex;flex-direction:column;gap:7px}.category-form label:nth-child(3){grid-column:1/-1}.category-form textarea{min-height:70px;resize:vertical}
.product-row{padding:19px 0;border-bottom:1px solid var(--adm-line);animation:admin-enter .35s ease both}.product-row-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:13px;font:9px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.08em}
.product-row-head button{border:1px solid transparent;background:transparent;color:#777;cursor:pointer;font:9px "DM Mono",monospace;padding:6px 9px;border-radius:6px;transition:.2s}.product-row-head button:hover{color:#ff7777;border-color:#ff777744;background:#ff77770d}
.product-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.product-form label{display:flex;flex-direction:column;gap:7px}.product-form label:last-child{grid-column:1/-1}
.product-form select{padding:13px;background:#090909;border:1px solid var(--adm-line);color:var(--adm-text);font:10px "DM Mono",monospace;border-radius:9px;outline:none}.product-form select:focus{border-color:var(--adm-accent)}
.admin-add-product{margin-top:18px;background:transparent;color:var(--adm-accent);border-color:#d8ff5555;width:100%;padding:16px}.admin-add-product:hover{background:var(--adm-accent);color:#090909}
.admin-footnote,.admin-message{font:9px/1.8 "DM Mono",monospace;color:var(--adm-muted)}.admin-footnote{margin-top:22px;padding:15px 18px;border:1px dashed #3a3a3a;border-radius:10px;background:#ffffff04}
.admin-message{margin-top:12px;min-height:16px}.admin-footer{display:flex;justify-content:space-between;padding:24px 0;border-top:1px solid var(--adm-line);font:8px "DM Mono",monospace;letter-spacing:.1em;color:#686868}
[hidden]{display:none!important}
@media(max-width:800px){.admin-login{grid-template-columns:1fr;gap:20px;margin:28px auto;padding:24px}.admin-columns{grid-template-columns:1fr}.admin-categories{position:static}.admin-categories #category-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}.admin-toolbar{align-items:start;flex-direction:column}.admin-stats article{padding:17px}.admin-stats strong{font-size:34px}}
@media(max-width:520px){.admin-shell{padding:0 16px}.admin-top{height:68px;font-size:8px}.admin-top>span{display:none}.admin-intro{padding:58px 0 34px}.admin-intro h1{font-size:clamp(48px,15vw,76px)}.admin-stats{gap:7px;margin:20px 0}.admin-stats article{padding:13px 11px}.admin-stats span{font-size:7px;line-height:1.5}.admin-stats strong{font-size:27px;margin-top:10px}.admin-actions{width:100%}.admin-actions>span{width:100%;margin-bottom:4px}.admin-secondary{flex:1}.admin-categories,.admin-editor{padding:14px}.admin-categories #category-list{grid-template-columns:1fr 1fr}.category-choice{font-size:10px;padding:12px 8px}.product-form,.category-form{grid-template-columns:1fr}.category-form label:nth-child(3),.product-form label:last-child{grid-column:auto}.admin-footer{font-size:7px}}
@media(prefers-reduced-motion:reduce){.admin-shell *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style>
<script>
const shell = document.querySelector(".admin-shell");
const loginForm = document.querySelector("#login-form");
const workspace = document.querySelector("#workspace");
const loginPanel = document.querySelector("#login-panel");
const apiInput = document.querySelector("#api-url");
const tokenInput = document.querySelector("#admin-token");
const loginMessage = document.querySelector("#login-message");
const saveMessage = document.querySelector("#save-message");
let apiBase = shell.dataset.apiBase || "";
const demoMode = !apiBase;
const initialCatalog = JSON.parse(shell.dataset.initialCatalog || '{"categories":[]}');
let token = "";
let catalog = JSON.parse(JSON.stringify(initialCatalog));
let selectedSlug = "";

const api = async (path, options = {}) => {
  const response = await fetch(apiBase.replace(/\/$/, "") + path, {
    ...options,
    headers: { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}), ...(options.headers || {}) }
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.error || `API error ${response.status}`);
  return data;
};
const el = (tag, attrs = {}, text = "") => {
  const node = document.createElement(tag);
  Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
  if (text) node.textContent = text;
  return node;
};
function render() {
  const categories = catalog.categories;
  const products = categories.reduce((sum, category) => sum + category.products.length, 0);
  document.querySelector("#stat-categories").textContent = categories.length;
  document.querySelector("#stat-products").textContent = products;
  document.querySelector("#stat-unknown").textContent = categories.flatMap(c => c.products).filter(p => p.availability === "unknown").length;
  document.querySelector("#catalog-count").textContent = `${products} PRODUCTS`;
  const list = document.querySelector("#category-list");
  list.replaceChildren();
  categories.forEach(category => {
    const button = el("button", { class: "category-choice", type: "button", "aria-current": String(category.slug === selectedSlug) }, category.title);
    button.addEventListener("click", () => { selectedSlug = category.slug; render(); });
    list.append(button);
  });
  const category = categories.find(c => c.slug === selectedSlug);
  const editor = document.querySelector("#category-editor");
  const productList = document.querySelector("#product-list");
  editor.replaceChildren(); productList.replaceChildren();
  document.querySelector("#selected-category-label").textContent = category ? category.index : "ВЫБЕРИ КАТЕГОРИЮ";
  if (!category) return;
  const categoryForm = el("div", { class: "category-form" });
  const fields = [
    ["Название", "title", category.title],
    ["Индекс", "index", category.index],
    ["Описание", "description", category.description]
  ];
  fields.forEach(([label, key, value]) => {
    const wrap = el("label", {}, label);
    const input = el(key === "description" ? "textarea" : "input", { value });
    input.value = value;
    input.addEventListener("input", () => { category[key] = input.value; });
    wrap.append(input); categoryForm.append(wrap);
  });
  editor.append(categoryForm);
  category.products.forEach((product, index) => {
    const row = el("article", { class: "product-row" });
    const head = el("div", { class: "product-row-head" });
    head.append(el("span", {}, `PRODUCT / ${String(index + 1).padStart(2, "0")}`));
    const remove = el("button", { type: "button" }, "УДАЛИТЬ ×");
    remove.addEventListener("click", () => { category.products.splice(index, 1); render(); });
    head.append(remove); row.append(head);
    const form = el("div", { class: "product-form" });
    const productFields = [
      ["Название", "name"], ["Цена", "price"], ["Код", "code"],
      ["Характеристики", "details"], ["Примечание", "note"], ["Символ", "symbol"]
    ];
    productFields.forEach(([label, key]) => {
      const wrap = el("label", {}, label);
      const input = el("input", { value: product[key] ?? "" });
      input.value = product[key] ?? "";
      input.addEventListener("input", () => { product[key] = input.value; });
      wrap.append(input); form.append(wrap);
    });
    const statusWrap = el("label", {}, "Наличие");
    const status = el("select");
    [["unknown","Не указано"],["in_stock","В наличии"],["out_of_stock","Нет в наличии"]].forEach(([value,label]) => {
      const option = el("option", { value }, label); option.selected = product.availability === value; status.append(option);
    });
    status.addEventListener("change", () => { product.availability = status.value; });
    statusWrap.append(status); form.append(statusWrap); row.append(form); productList.append(row);
  });
}
document.querySelector("#add-product-button").addEventListener("click", () => {
  const category = catalog.categories.find(c => c.slug === selectedSlug);
  if (!category) return;
  category.products.push({ code:"NEW", name:"Новый товар", details:"", price:"0 ₽", note:"", symbol:"NEW", availability:"unknown" });
  render();
});
document.querySelector("#add-category-button").addEventListener("click", () => {
  const slug = prompt("Slug категории (латиницей, например storage):");
  if (!slug || !/^[a-z0-9-]+$/.test(slug) || catalog.categories.some(c => c.slug === slug)) return;
  catalog.categories.push({ slug, title:"Новая категория", index:` ${String(catalog.categories.length + 1).padStart(2,"0")} / NEW`, description:"ОПИСАНИЕ КАТЕГОРИИ.", products:[] });
  selectedSlug = slug; render();
});
document.querySelector("#save-button").addEventListener("click", async () => {
  if (demoMode) {
    saveMessage.textContent = "ДЕМО: ИЗМЕНЕНИЯ ОСТАНУТСЯ В ЭТОЙ ВКЛАДКЕ. API ДЛЯ ПОСТОЯННОГО СОХРАНЕНИЯ ПОКА НЕ ПОДКЛЮЧЁН.";
    return;
  }
  saveMessage.textContent = "СОХРАНЯЕМ…";
  try { await api("/api/admin/catalog", { method:"PUT", body:JSON.stringify(catalog) }); saveMessage.textContent = "ИЗМЕНЕНИЯ СОХРАНЕНЫ НА СЕРВЕРЕ."; render(); }
  catch (error) { saveMessage.textContent = error.message; }
});
document.querySelector("#refresh-button").addEventListener("click", () => {
  if (demoMode) {
    catalog = JSON.parse(JSON.stringify(initialCatalog));
    selectedSlug = catalog.categories[0]?.slug || "";
    saveMessage.textContent = "ДЕМО-КАТАЛОГ ВОССТАНОВЛЕН К ИСХОДНОМУ СОСТОЯНИЮ.";
    render();
    return;
  }
  loadCatalog();
});
document.querySelector("#logout-button").addEventListener("click", () => {
  token = ""; catalog = { categories: [] }; workspace.hidden = true; loginPanel.hidden = false; tokenInput.value = "";
});
async function loadCatalog() {
  catalog = await api("/api/catalog");
  selectedSlug = catalog.categories[0]?.slug || "";
  loginPanel.hidden = true; workspace.hidden = false; render();
}
if (demoMode) {
  loginPanel.hidden = true;
  workspace.hidden = false;
  selectedSlug = catalog.categories[0]?.slug || "";
  document.querySelector("#logout-button").hidden = true;
  document.querySelector("#admin-mode-note").textContent = "DEMO MODE / БЕЗ ПАРОЛЯ. Можно проверять интерфейс, редактировать позиции и добавлять категории. Изменения живут только в этой вкладке и не сохраняются на сайте.";
  render();
}

loginForm.addEventListener("submit", async event => {
  event.preventDefault(); loginMessage.textContent = "ПРОВЕРЯЕМ ДОСТУП…";
  apiBase = apiInput.value.trim().replace(/\/$/, "");
  token = tokenInput.value;
  try {
    await api("/api/admin/session", { method:"POST", body:JSON.stringify({ token }) });
    await loadCatalog();
  } catch (error) { token = ""; loginMessage.textContent = error.message; }
});
</script>
