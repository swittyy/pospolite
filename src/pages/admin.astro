---
import SiteLayout from "../layouts/SiteLayout.astro";
const apiBase = import.meta.env.PUBLIC_API_URL ?? "";
---
<SiteLayout title="Админ-панель — POSPOLITE" description="Управление каталогом POSPOLITE." noindex>
  <main class="admin-shell" data-api-base={apiBase}>
    <header class="admin-top"><a class="wordmark" href={import.meta.env.BASE_URL}>POSPOLITE<span class="wordmark-mark">®</span></a><span>CONTROL PANEL / 001</span><a href={import.meta.env.BASE_URL}>НА САЙТ ↗</a></header>
    <section class="admin-intro"><p class="eyebrow">POSPOLITE / MANAGEMENT</p><h1>УПРАВЛЕНИЕ<span>.</span></h1><p>Каталог, цены и наличие — в одном месте.</p></section>
    <section class="admin-login" id="login-panel">
      <div class="login-copy">
        <span class="admin-label">PRIVATE ACCESS / 01</span>
        <div class="login-orbit" aria-hidden="true"><span>P</span><i></i><b></b></div>
        <h2>ТВОЯ СИСТЕМА.<br/><em>ТВОИ ПРАВИЛА.</em></h2>
        <p>Управляй ассортиментом POSPOLITE: добавляй позиции, меняй цены, обновляй наличие и сохраняй всё на сервере.</p>
        <div class="login-status"><span></span> SECURE GATEWAY <small>ENCRYPTED SESSION</small></div>
      </div>
      <form id="login-form" class="login-card">
        <span class="admin-label">WELCOME BACK / ADMIN</span>
        <h3>Вход в панель</h3>
        <p>Введи пароль администратора, чтобы продолжить.</p>
        <label for="admin-token">ПАРОЛЬ ДОСТУПА</label>
        <div class="password-wrap"><input id="admin-token" type="password" autocomplete="current-password" placeholder="Введи пароль" required/><button type="button" id="toggle-password" aria-label="Показать пароль">◉</button></div>
        <button class="login-submit" id="login-submit" type="submit"><span>ВОЙТИ В СИСТЕМУ</span><b>↗</b></button>
        <p class="admin-message" id="login-message" role="status" aria-live="polite"></p>
        <div class="login-card-foot"><span>POSPOLITE AUTH</span><span>NO PUBLIC ACCESS</span></div>
      </form>
    </section>
    <section class="boot-screen" id="boot-screen" hidden aria-live="polite">
      <div class="boot-mark">P<span>.</span></div><div class="boot-track"><i></i></div>
      <p id="boot-caption">ПРОВЕРКА ДОСТУПА</p><small>POSPOLITE CONTROL SYSTEM / INITIALIZING</small>
    </section>
    <section class="admin-workspace" id="workspace" hidden>
      <div class="admin-toolbar"><div><span class="admin-label">02 / OVERVIEW</span><h2>КАТАЛОГ</h2></div><div class="admin-actions"><span class="connection-state"><i></i> LIVE CONNECTION</span><span id="catalog-count"></span><button class="admin-secondary" id="refresh-button" type="button">↻ ОБНОВИТЬ</button><button class="admin-secondary" id="logout-button" type="button">ВЫЙТИ ↗</button></div></div>
      <div class="admin-stats"><article><span>КАТЕГОРИИ</span><strong id="stat-categories">—</strong></article><article><span>ПОЗИЦИИ</span><strong id="stat-products">—</strong></article><article><span>НАЛИЧИЕ НЕ УКАЗАНО</span><strong id="stat-unknown">—</strong></article></div>
      <div class="admin-columns">
        <aside class="admin-categories"><div class="admin-subhead"><span>РАЗДЕЛЫ МАГАЗИНА</span><button id="add-category-button" type="button" aria-label="Добавить категорию">＋</button></div><div id="category-list"></div><div id="category-create" hidden></div></aside>
        <section class="admin-editor"><div class="admin-subhead"><div><span class="admin-label">CATALOG EDITOR</span><h3 id="selected-category-label">ВЫБЕРИ КАТЕГОРИЮ</h3></div><div class="editor-actions"><button class="admin-secondary danger-action" id="delete-category-button" type="button">УДАЛИТЬ КАТЕГОРИЮ</button><button id="save-button" type="button">СОХРАНИТЬ ВСЁ <b>↗</b></button></div></div><div id="category-editor"></div><div id="product-list"></div><button class="admin-add-product" id="add-product-button" type="button">＋ ДОБАВИТЬ ТОВАР</button><p class="admin-message" id="save-message" role="status"></p></section>
      </div>
      <p class="admin-footnote" id="admin-mode-note"><b>ВАЖНО:</b> изменения вступят в силу после сохранения на сервере. Не закрывай вкладку во время записи.</p>
    </section>
    <footer class="admin-footer"><span>POSPOLITE ADMIN / PRIVATE ACCESS</span><span>BUILD WITH CARE.</span></footer>
  </main>
</SiteLayout>
<style>
:root{--adm-bg:#0a0a0a;--adm-panel:#111;--adm-panel2:#171717;--adm-line:#292929;--adm-text:#f4f4f0;--adm-muted:#858585;--adm-accent:#d8ff55;--adm-radius:18px}
body{background:var(--adm-bg)!important}
.admin-shell{position:relative;isolation:isolate;min-height:100vh;padding:0 clamp(18px,4vw,64px);background:radial-gradient(ellipse at 78% 0%,rgba(216,255,85,.075),transparent 34%),var(--adm-bg);color:var(--adm-text);font-family:Manrope,sans-serif;overflow:hidden}
.admin-shell:before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.15;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:54px 54px;mask-image:linear-gradient(to bottom,black,transparent 75%)}
.admin-top{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--adm-line);font:10px "DM Mono",monospace;letter-spacing:.08em;position:relative}
.wordmark{font:800 20px Manrope,sans-serif;letter-spacing:-.09em;color:var(--adm-text)!important}.wordmark-mark{font:9px "DM Mono";vertical-align:top;margin-left:4px;color:var(--adm-accent)}
.admin-top>span{color:var(--adm-muted)}.admin-top>a:last-child{color:var(--adm-text);padding:10px 14px;border:1px solid var(--adm-line);border-radius:999px;transition:.25s}.admin-top>a:last-child:hover{background:var(--adm-accent);color:#090909;border-color:var(--adm-accent);transform:translateY(-2px)}
.admin-intro{padding:clamp(54px,8vw,104px) 0 42px;border-bottom:1px solid var(--adm-line);position:relative}
.admin-intro .eyebrow,.admin-label{font:10px "DM Mono",monospace;letter-spacing:.14em;color:var(--adm-muted)}
.admin-intro .eyebrow:before{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--adm-accent);margin:0 10px 1px 0;box-shadow:0 0 14px var(--adm-accent)}
.admin-intro h1{margin:24px 0 14px;font-size:clamp(54px,10vw,124px);font-weight:800;letter-spacing:-.095em;line-height:.86}.admin-intro h1 span{color:var(--adm-accent)}
.admin-intro>p:last-child{color:#aaa;font-size:14px;letter-spacing:-.02em}
.admin-intro:after{content:"P /";position:absolute;right:2%;bottom:18px;font:800 clamp(76px,15vw,190px)/.8 Manrope,sans-serif;letter-spacing:-.13em;color:rgba(255,255,255,.035);pointer-events:none}
.admin-login{max-width:1040px;margin:44px auto;display:grid;grid-template-columns:1fr minmax(300px,440px);gap:52px;padding:34px;border:1px solid var(--adm-line);border-radius:var(--adm-radius);background:linear-gradient(135deg,#151515,#0e0e0e);box-shadow:0 24px 90px #0008}
.admin-login h2,.admin-toolbar h2{font-size:clamp(26px,4vw,42px);letter-spacing:-.07em;margin:18px 0 8px;font-weight:800}.admin-login p{font-size:12px;color:var(--adm-muted);line-height:1.8}
.admin-login form{display:flex;flex-direction:column;gap:9px}.admin-login label,.product-form label,.category-form label{font:9px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.06em;margin-top:8px}
.admin-login input,.product-form input,.category-form input,.category-form textarea{width:100%;padding:14px 15px;border:1px solid var(--adm-line);background:#090909;color:var(--adm-text);font:12px "DM Mono",monospace;border-radius:10px;outline:none;transition:border .2s,box-shadow .2s}
.admin-login input:focus,.product-form input:focus,.category-form input:focus,.category-form textarea:focus{border-color:var(--adm-accent);box-shadow:0 0 0 3px #d8ff5518}
.admin-login button,.admin-subhead button,.admin-add-product{border:1px solid var(--adm-accent);background:var(--adm-accent);color:#090909;padding:14px 18px;font:700 10px "DM Mono",monospace;letter-spacing:.05em;cursor:pointer;border-radius:10px;transition:transform .2s,box-shadow .2s,background .2s}
.admin-login button:hover,.admin-subhead button:hover,.admin-add-product:hover{transform:translateY(-2px);box-shadow:0 8px 24px #d8ff5522}
.admin-workspace{padding:46px 0 54px;animation:admin-enter .55s cubic-bezier(.2,.8,.2,1) both}
@keyframes admin-enter{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.admin-toolbar{display:flex;justify-content:space-between;align-items:end;gap:20px}.admin-toolbar h2{font-size:clamp(32px,5vw,54px);margin:10px 0 0}
.admin-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.admin-actions>span{font:9px "DM Mono",monospace;color:var(--adm-muted);margin-right:8px}
.admin-secondary{padding:11px 14px;background:#111;color:var(--adm-text);border:1px solid var(--adm-line);font:9px "DM Mono",monospace;cursor:pointer;border-radius:9px;transition:.2s}
.admin-secondary:hover{border-color:var(--adm-accent);color:var(--adm-accent);transform:translateY(-2px)}
.admin-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:30px 0}
.admin-stats article{position:relative;overflow:hidden;padding:22px 24px;background:linear-gradient(145deg,#171717,#101010);border:1px solid var(--adm-line);border-radius:14px;transition:transform .25s,border-color .25s}
.admin-stats article:hover{transform:translateY(-4px);border-color:#555}.admin-stats article:after{content:"";position:absolute;width:90px;height:90px;right:-30px;bottom:-44px;border:1px solid #ffffff12;border-radius:50%;box-shadow:0 0 0 14px #ffffff05,0 0 0 28px #ffffff03}
.admin-stats span{display:block;font:9px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.1em}.admin-stats strong{display:block;margin-top:15px;font:500 42px "DM Mono",monospace;letter-spacing:-.08em;color:var(--adm-text)}#stat-unknown{color:var(--adm-accent)}
.admin-columns{display:grid;grid-template-columns:260px minmax(0,1fr);gap:14px;align-items:start}
.admin-categories,.admin-editor{border:1px solid var(--adm-line);background:linear-gradient(145deg,#141414,#0e0e0e);padding:20px;border-radius:14px;min-width:0}
.admin-categories{position:sticky;top:18px}.admin-subhead{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:16px;border-bottom:1px solid var(--adm-line);font:9px "DM Mono",monospace;letter-spacing:.1em;color:var(--adm-muted)}
.admin-subhead button{padding:9px 12px;border-radius:8px}
.category-choice{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:14px 12px;border:0;border-bottom:1px solid #ffffff0a;background:transparent;color:#bcbcbc;text-align:left;font:11px Manrope,sans-serif;cursor:pointer;border-radius:8px;transition:.2s}
.category-choice:after{content:"↗";opacity:0;transform:translateX(-4px);transition:.2s;color:var(--adm-accent)}
.category-choice:hover,.category-choice[aria-current=true]{background:#ffffff08;color:#fff}.category-choice[aria-current=true]{box-shadow:inset 2px 0 var(--adm-accent);padding-left:16px}.category-choice[aria-current=true]:after,.category-choice:hover:after{opacity:1;transform:translateX(0)}
.category-form{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px 0;border-bottom:1px solid var(--adm-line)}
.category-form label{display:flex;flex-direction:column;gap:7px}.category-form label:nth-child(3){grid-column:1/-1}.category-form textarea{min-height:70px;resize:vertical}
.product-row{padding:19px 0;border-bottom:1px solid var(--adm-line);animation:admin-enter .35s ease both}.product-row-head{display:flex;justify-content:space-between;gap:12px;margin-bottom:13px;font:9px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.08em}
.product-row-head button{border:1px solid transparent;background:transparent;color:#777;cursor:pointer;font:9px "DM Mono",monospace;padding:6px 9px;border-radius:6px;transition:.2s}.product-row-head button:hover{color:#ff7777;border-color:#ff777744;background:#ff77770d}
.product-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.product-form label{display:flex;flex-direction:column;gap:7px}.product-form label:last-child{grid-column:1/-1}
.product-form select{padding:13px;background:#090909;border:1px solid var(--adm-line);color:var(--adm-text);font:10px "DM Mono",monospace;border-radius:9px;outline:none}.product-form select:focus{border-color:var(--adm-accent)}
.admin-add-product{margin-top:18px;background:transparent;color:var(--adm-accent);border-color:#d8ff5555;width:100%;padding:16px}.admin-add-product:hover{background:var(--adm-accent);color:#090909}
.admin-footnote,.admin-message{font:9px/1.8 "DM Mono",monospace;color:var(--adm-muted)}.admin-footnote{margin-top:22px;padding:15px 18px;border:1px dashed #3a3a3a;border-radius:10px;background:#ffffff04}
.admin-message{margin-top:12px;min-height:16px}.admin-footer{display:flex;justify-content:space-between;padding:24px 0;border-top:1px solid var(--adm-line);font:8px "DM Mono",monospace;letter-spacing:.1em;color:#686868}
[hidden]{display:none!important}
@media(max-width:800px){.admin-login{grid-template-columns:1fr;gap:20px;margin:28px auto;padding:24px}.admin-columns{grid-template-columns:1fr}.admin-categories{position:static}.admin-categories #category-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}.admin-toolbar{align-items:start;flex-direction:column}.admin-stats article{padding:17px}.admin-stats strong{font-size:34px}}
@media(max-width:520px){.admin-shell{padding:0 16px}.admin-top{height:68px;font-size:8px}.admin-top>span{display:none}.admin-intro{padding:58px 0 34px}.admin-intro h1{font-size:clamp(48px,15vw,76px)}.admin-stats{gap:7px;margin:20px 0}.admin-stats article{padding:13px 11px}.admin-stats span{font-size:7px;line-height:1.5}.admin-stats strong{font-size:27px;margin-top:10px}.admin-actions{width:100%}.admin-actions>span{width:100%;margin-bottom:4px}.admin-secondary{flex:1}.admin-categories,.admin-editor{padding:14px}.admin-categories #category-list{grid-template-columns:1fr 1fr}.category-choice{font-size:10px;padding:12px 8px}.product-form,.category-form{grid-template-columns:1fr}.category-form label:nth-child(3),.product-form label:last-child{grid-column:auto}.admin-footer{font-size:7px}}
@media(prefers-reduced-motion:reduce){.admin-shell *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* POSPOLITE ADMIN / SIGN-IN EXPERIENCE */
.admin-intro{padding:52px 0 30px}.admin-intro h1{font-size:clamp(46px,8vw,92px);margin:17px 0 10px}
.admin-login{max-width:1120px;min-height:470px;margin:34px auto 70px;padding:0;display:grid;grid-template-columns:1.08fr .92fr;gap:0;overflow:hidden;border:1px solid #303030;background:#101010;box-shadow:0 35px 120px #000b}
.login-copy{position:relative;padding:clamp(28px,5vw,58px);overflow:hidden;background:radial-gradient(circle at 35% 45%,#d8ff5516,transparent 42%),linear-gradient(140deg,#191d12,#10110d 65%,#0c0c0c)}
.login-copy:after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 20%,#ffffff05 50%,transparent 80%);transform:translateX(-100%);animation:login-sheen 7s ease-in-out infinite}
@keyframes login-sheen{0%,55%{transform:translateX(-100%)}80%,100%{transform:translateX(100%)}}
.login-copy h2{position:relative;z-index:1;margin:22px 0 16px;font-size:clamp(28px,4vw,48px);line-height:.98;letter-spacing:-.075em;font-weight:800}.login-copy h2 em{font-style:normal;color:var(--adm-accent)}
.login-copy>p{position:relative;z-index:1;max-width:390px;color:#a6a99a;font-size:12px;line-height:1.9}
.login-orbit{position:relative;display:grid;place-items:center;width:150px;height:150px;margin:22px 0 14px;border:1px solid #d8ff5544;border-radius:50%;box-shadow:0 0 60px #d8ff5510,inset 0 0 45px #d8ff550a;animation:orbit-float 5s ease-in-out infinite}
.login-orbit:before,.login-orbit:after{content:"";position:absolute;inset:12px;border:1px dashed #d8ff5544;border-radius:50%;animation:orbit-spin 18s linear infinite}
.login-orbit:after{inset:-9px;border-style:solid;border-color:#ffffff12;animation-direction:reverse;animation-duration:30s}
.login-orbit span{font:800 68px Manrope,sans-serif;letter-spacing:-.13em;color:#f5f7eb;text-shadow:0 0 35px #d8ff5555;transform:translateX(-4px)}
.login-orbit i,.login-orbit b{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--adm-accent);box-shadow:0 0 18px var(--adm-accent);top:14px;left:28px}.login-orbit b{top:auto;left:auto;right:9px;bottom:45px;width:4px;height:4px}
@keyframes orbit-spin{to{transform:rotate(360deg)}}@keyframes orbit-float{50%{transform:translateY(-6px)}}
.login-status{position:absolute;bottom:30px;left:clamp(28px,5vw,58px);display:flex;align-items:center;gap:9px;font:9px "DM Mono",monospace;color:#d6dfbf;letter-spacing:.09em}.login-status>span,.connection-state i{width:7px;height:7px;border-radius:50%;background:var(--adm-accent);box-shadow:0 0 12px var(--adm-accent)}.login-status small{color:#777;margin-left:8px}
.login-card{align-self:center;display:flex;flex-direction:column;gap:12px;padding:clamp(28px,5vw,58px);background:linear-gradient(145deg,#151515,#101010)}
.login-card h3{margin:10px 0 0;font-size:clamp(27px,3vw,38px);letter-spacing:-.07em}.login-card>p:not(.admin-message){margin:0 0 20px;color:#858585;font-size:12px;line-height:1.7}
.login-card>label{font:9px "DM Mono",monospace;letter-spacing:.12em;color:#aaa}.password-wrap{position:relative}
.password-wrap input{width:100%;height:54px;padding:0 52px 0 16px;border:1px solid #383838;border-radius:11px;background:#090909;color:#fff;font:13px "DM Mono",monospace;outline:none;transition:.25s}
.password-wrap input:focus{border-color:var(--adm-accent);box-shadow:0 0 0 4px #d8ff5514,0 0 30px #d8ff5509}
.password-wrap button{position:absolute;right:8px;top:7px;width:40px;height:40px;border:0;border-radius:8px;background:#202020;color:#aaa;cursor:pointer}
.login-submit{display:flex;align-items:center;justify-content:space-between;margin-top:8px;padding:0 18px;height:54px;border:1px solid var(--adm-accent);border-radius:11px;background:var(--adm-accent);color:#080a04;font:800 10px "DM Mono",monospace;letter-spacing:.1em;cursor:pointer;transition:.25s}
.login-submit b{font-size:20px}.login-submit:hover{transform:translateY(-3px);box-shadow:0 12px 35px #d8ff5525}.login-submit:disabled{opacity:.5;cursor:wait;transform:none}
.login-card-foot{display:flex;justify-content:space-between;margin-top:26px;padding-top:16px;border-top:1px solid #292929;font:8px "DM Mono",monospace;letter-spacing:.1em;color:#626262}
.admin-message[data-state=error]{color:#ff8b8b}.admin-message[data-state=success]{color:var(--adm-accent)}
.boot-screen{min-height:440px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;animation:boot-in .55s ease both}
.boot-mark{font:900 116px/.9 Manrope,sans-serif;letter-spacing:-.16em;color:#f4f4f0;text-shadow:0 0 55px #d8ff5533;animation:boot-pulse 1.2s ease-in-out infinite alternate}.boot-mark span{color:var(--adm-accent)}
.boot-track{width:min(320px,70vw);height:2px;background:#292929;overflow:hidden}.boot-track i{display:block;width:35%;height:100%;background:var(--adm-accent);box-shadow:0 0 15px var(--adm-accent);animation:boot-load 1.35s cubic-bezier(.7,0,.2,1) infinite}
.boot-screen p{margin:12px 0 0;font:10px "DM Mono",monospace;letter-spacing:.18em;color:#e9e9e9}.boot-screen small{font:8px "DM Mono",monospace;letter-spacing:.1em;color:#696969}
@keyframes boot-in{from{opacity:0;filter:blur(12px);transform:scale(.97)}to{opacity:1;filter:blur(0);transform:scale(1)}}@keyframes boot-pulse{to{transform:scale(1.05);text-shadow:0 0 80px #d8ff5566}}@keyframes boot-load{from{transform:translateX(-120%)}to{transform:translateX(320%)}}
.admin-workspace{padding-top:36px}.admin-toolbar h2{font-size:clamp(35px,5vw,62px)}
.connection-state{display:flex;align-items:center;gap:8px!important;color:#c9d4ac!important}.connection-state i{display:inline-block}
.admin-subhead h3{margin:8px 0 0;color:#fff;font:700 21px Manrope,sans-serif;letter-spacing:-.05em}.editor-actions{display:flex;align-items:center;gap:8px}.danger-action{color:#c78383;border-color:#663c3c}.danger-action:hover{border-color:#ff7777;color:#ff7777}
.admin-subhead #save-button{display:flex;align-items:center;gap:18px;padding:12px 15px;border:1px solid var(--adm-accent);border-radius:9px;background:var(--adm-accent);color:#090909;font:800 9px "DM Mono",monospace;cursor:pointer;transition:.2s}.admin-subhead #save-button:hover{transform:translateY(-2px);box-shadow:0 8px 25px #d8ff5522}.admin-subhead #save-button:disabled{opacity:.55}
.category-choice{gap:10px;padding:12px 10px}.category-number{font:9px "DM Mono",monospace;color:#6c6c6c}.category-name{flex:1}.category-choice small{font:9px "DM Mono",monospace;color:#777}
.category-form{grid-template-columns:repeat(2,minmax(0,1fr));padding:18px 0 22px}.category-form label,.product-form label{gap:8px;font-size:8px;letter-spacing:.1em}
.category-form input,.category-form textarea,.product-form input{height:44px;padding:0 13px;border-radius:8px;font:11px Manrope,sans-serif}.category-form textarea{height:auto;min-height:44px;padding:12px}.product-form{grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.product-form select{height:44px;border-radius:8px}
.product-row{padding:23px 0}.product-row-head{align-items:center}.product-state{margin-left:auto;color:#9aa18b;font-size:8px}.remove-product{color:#a77a7a!important}.remove-product:hover{border-color:#ff7777!important;color:#ff7777!important}
.new-category-form{display:grid;gap:9px;padding:14px 0}.new-category-form small{font:8px "DM Mono",monospace;color:var(--adm-muted);letter-spacing:.1em}.new-category-form input{height:40px;padding:0 11px;border:1px solid #353535;border-radius:8px;background:#080808;color:white;outline:none}.new-category-form input:focus{border-color:var(--adm-accent)}.new-category-form button{padding:11px;border:0;border-radius:8px;background:var(--adm-accent);font:9px "DM Mono",monospace;cursor:pointer}
.empty-editor{padding:55px 20px;text-align:center;color:#777;font-size:12px}.admin-footnote{border-color:#383838}.admin-actions{gap:9px}
@media(max-width:760px){.admin-login{grid-template-columns:1fr;margin:22px auto 42px}.login-copy{min-height:360px}.login-orbit{width:120px;height:120px}.login-orbit span{font-size:56px}.login-status{bottom:22px}.login-card{padding:28px}.admin-subhead{align-items:flex-start;flex-direction:column}.editor-actions{width:100%;flex-wrap:wrap}.editor-actions>*{flex:1}.admin-stats{margin:22px 0}}
@media(max-width:520px){.admin-intro{padding-top:42px}.admin-login{margin-bottom:30px}.login-copy{min-height:330px;padding:24px}.login-card{padding:24px}.login-status{left:24px;gap:6px;font-size:8px}.login-status small{margin-left:2px}.product-form,.category-form{grid-template-columns:1fr}.product-form label:last-child,.category-form label:nth-child(3){grid-column:auto}.admin-actions .connection-state{width:100%}.admin-actions #catalog-count{margin-right:auto}.admin-subhead #save-button{flex:1}.danger-action{flex:0 0 auto}.boot-mark{font-size:94px}}
@media(prefers-reduced-motion:reduce){.login-orbit,.login-orbit:before,.login-orbit:after,.boot-mark,.boot-track i,.login-copy:after{animation:none!important}.boot-track i{width:100%}}
</style>
<script>
type Availability = "unknown" | "in_stock" | "out_of_stock";
interface Product { code: string; name: string; details: string; price: string; note: string; symbol: string; availability: Availability; }
interface Category { slug: string; title: string; index: string; description: string; products: Product[]; }
interface Catalog { categories: Category[]; }
const errorText = (error: unknown): string => (error instanceof Error ? error.message : String(error));
const $ = <T extends HTMLElement = HTMLElement>(selector: string): T => {
  const node = document.querySelector<T>(selector);
  if (!node) throw new Error(`Missing element: ${selector}`);
  return node;
};
const shell = $(".admin-shell");
const loginForm = $<HTMLFormElement>("#login-form");
const workspace = $("#workspace");
const loginPanel = $("#login-panel");
const tokenInput = $<HTMLInputElement>("#admin-token");
const loginMessage = $("#login-message");
const saveMessage = $("#save-message");
const bootScreen = $("#boot-screen");
const bootCaption = $("#boot-caption");
const apiBase = (shell.dataset.apiBase || "").replace(/\/$/, "");
let token = "";
let catalog: Catalog = { categories: [] };
let selectedSlug = "";
let isSaving = false;
const api = async <T,>(path: string, options: RequestInit = {}): Promise<T> => {
  if (!apiBase) throw new Error("Сервер управления пока не подключён. Нужен запущенный POSPOLITE API.");
  const response = await fetch(apiBase + path, {
    ...options,
    headers: { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}), ...((options.headers as Record<string, string> | undefined) || {}) }
  });
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error((data as { error?: string }).error || `Ошибка сервера ${response.status}`);
  return data as T;
};
const el = <K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, string> = {}, text = ""): HTMLElementTagNameMap[K] => {
  const node = document.createElement(tag);
  Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
  if (text) node.textContent = text;
  return node;
};
function setMessage(node: HTMLElement, text: string, state = "") { node.textContent = text; node.dataset.state = state; }
function render() {
  const categories = catalog.categories || [];
  const products = categories.reduce((sum, category) => sum + category.products.length, 0);
  $("#stat-categories").textContent = String(categories.length);
  $("#stat-products").textContent = String(products);
  $("#stat-unknown").textContent = categories.flatMap(c => c.products).filter(p => p.availability === "unknown").length.toString();
  $("#catalog-count").textContent = `${products} ПОЗИЦИЙ`;
  const list = $("#category-list");
  list.replaceChildren();
  categories.forEach((category, index) => {
    const button = el("button", { class: "category-choice", type: "button", "aria-current": String(category.slug === selectedSlug) });
    button.append(el("span", { class: "category-number" }, String(index + 1).padStart(2, "0")));
    button.append(el("span", { class: "category-name" }, category.title));
    button.append(el("small", {}, String(category.products.length)));
    button.addEventListener("click", () => { selectedSlug = category.slug; render(); });
    list.append(button);
  });
  const category = categories.find(c => c.slug === selectedSlug);
  const editor = $("#category-editor");
  const productList = $("#product-list");
  editor.replaceChildren(); productList.replaceChildren();
  $("#selected-category-label").textContent = category ? category.title : "ВЫБЕРИ КАТЕГОРИЮ";
  $("#delete-category-button").hidden = !category;
  $("#add-product-button").hidden = !category;
  if (!category) {
    productList.append(el("div", { class: "empty-editor" }, "Выбери раздел слева или создай новую категорию."));
    return;
  }
  const categoryForm = el("div", { class: "category-form" });
  const fields: [string, "title" | "slug" | "index" | "description"][] = [["НАЗВАНИЕ РАЗДЕЛА", "title"], ["URL SLUG", "slug"], ["КОРОТКИЙ ИНДЕКС", "index"], ["ОПИСАНИЕ", "description"]];
  fields.forEach(([label, key]) => {
    const wrap = el("label", {}, label);
    const input = el(key === "description" ? "textarea" : "input", { value: category[key] || "", placeholder: key === "slug" ? "например storage" : label });
    input.value = category[key] || "";
    if (key === "slug") input.addEventListener("change", () => {
      const next = input.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, "-").replace(/-+/g, "-");
      if (next && !categories.some(c => c !== category && c.slug === next)) { category.slug = next; selectedSlug = next; input.value = next; }
      else { input.value = category.slug; setMessage(saveMessage, "Такой URL уже используется или он некорректен.", "error"); }
    });
    else input.addEventListener("input", () => { category[key] = input.value; });
    wrap.append(input); categoryForm.append(wrap);
  });
  editor.append(categoryForm);
  category.products.forEach((product, index) => {
    const row = el("article", { class: "product-row" });
    const head = el("div", { class: "product-row-head" });
    head.append(el("span", {}, `ТОВАР ${String(index + 1).padStart(2, "0")}`));
    head.append(el("span", { class: "product-state" }, product.availability === "in_stock" ? "● В НАЛИЧИИ" : product.availability === "out_of_stock" ? "● НЕТ В НАЛИЧИИ" : "○ НЕ УКАЗАНО"));
    const remove = el("button", { type: "button", class: "remove-product" }, "УДАЛИТЬ ×");
    remove.addEventListener("click", () => { category.products.splice(index, 1); render(); });
    head.append(remove); row.append(head);
    const form = el("div", { class: "product-form" });
    const productFields: [string, "name" | "price" | "code" | "details" | "note" | "symbol", string][] = [
      ["НАЗВАНИЕ ТОВАРА", "name", "Например, GeForce RTX 3060"],
      ["ЦЕНА", "price", "Например, 24 990 ₽"],
      ["АРТИКУЛ / КОД", "code", "Например, GPU-3060"],
      ["ХАРАКТЕРИСТИКИ", "details", "Основные характеристики"],
      ["ПРИМЕЧАНИЕ", "note", "Состояние, комплектность и т.д."],
      ["МЕТКА / СИМВОЛ", "symbol", "Например, RTX"]
    ];
    productFields.forEach(([label, key, placeholder]) => {
      const wrap = el("label", {}, label);
      const input = el("input", { value: product[key] || "", placeholder });
      input.value = product[key] || "";
      input.addEventListener("input", () => { product[key] = input.value; });
      wrap.append(input); form.append(wrap);
    });
    const statusWrap = el("label", {}, "НАЛИЧИЕ");
    const status = el("select");
    [["unknown","Не указано"],["in_stock","В наличии"],["out_of_stock","Нет в наличии"]].forEach(([value,label]) => {
      const option = el("option", { value }, label); option.selected = product.availability === value; status.append(option);
    });
    status.addEventListener("change", () => { product.availability = status.value as Availability; });
    statusWrap.append(status); form.append(statusWrap); row.append(form); productList.append(row);
  });
}
$("#add-product-button").addEventListener("click", () => {
  const category = catalog.categories.find(c => c.slug === selectedSlug);
  if (!category) return;
  category.products.push({ code:"", name:"", details:"", price:"", note:"", symbol:"", availability:"unknown" });
  render();
  document.querySelector<HTMLInputElement>("#product-list .product-row:last-child input")?.focus();
});
$("#add-category-button").addEventListener("click", () => {
  const mount = $("#category-create");
  mount.hidden = !mount.hidden;
  if (mount.hidden) return;
  mount.replaceChildren();
  const form = el("form", { class: "new-category-form" });
  const title = el("input", { placeholder: "Например, SSD-накопители", required: "true" });
  const slug = el("input", { placeholder: "ssd", required: "true", pattern: "[a-z0-9\\-]+" });
  const create = el("button", { type: "submit" }, "СОЗДАТЬ РАЗДЕЛ ↗");
  form.append(el("small", {}, "НОВЫЙ РАЗДЕЛ"), title, slug, create);
  title.addEventListener("input", () => { if (!slug.dataset.edited) slug.value = title.value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""); });
  slug.addEventListener("input", () => { slug.dataset.edited = "true"; });
  form.addEventListener("submit", event => {
    event.preventDefault();
    const value = slug.value.trim();
    if (!value || !/^[a-z0-9-]+$/.test(value) || catalog.categories.some(c => c.slug === value)) {
      setMessage(saveMessage, "Укажи уникальный slug латиницей: a-z, 0-9 и дефис.", "error"); return;
    }
    catalog.categories.push({ slug:value, title:title.value.trim(), index:`${String(catalog.categories.length + 1).padStart(2,"0")} / NEW`, description:"", products:[] });
    selectedSlug = value; mount.hidden = true; render();
  });
  mount.append(form); title.focus();
});
$("#delete-category-button").addEventListener("click", () => {
  const index = catalog.categories.findIndex(c => c.slug === selectedSlug);
  if (index < 0 || !confirm(`Удалить раздел «${catalog.categories[index].title}» вместе со всеми товарами?`)) return;
  catalog.categories.splice(index, 1); selectedSlug = catalog.categories[0]?.slug || ""; render();
});
$("#save-button").addEventListener("click", async () => {
  if (isSaving) return;
  isSaving = true; const button = $<HTMLButtonElement>("#save-button"); button.disabled = true;
  setMessage(saveMessage, "СОХРАНЯЕМ КАТАЛОГ…");
  try {
    await api("/api/admin/catalog", { method:"PUT", body:JSON.stringify(catalog) });
    setMessage(saveMessage, "✓ ВСЁ СОХРАНЕНО НА СЕРВЕРЕ", "success");
    render();
  } catch (error) { setMessage(saveMessage, errorText(error), "error"); }
  finally { isSaving = false; button.disabled = false; }
});
$("#refresh-button").addEventListener("click", async () => {
  setMessage(saveMessage, "ЗАГРУЖАЕМ ПОСЛЕДНЮЮ ВЕРСИЮ…");
  try { await loadCatalog(false); setMessage(saveMessage, "КАТАЛОГ ОБНОВЛЁН.", "success"); }
  catch (error) { setMessage(saveMessage, errorText(error), "error"); }
});
$("#logout-button").addEventListener("click", () => {
  token = ""; catalog = { categories: [] }; workspace.hidden = true; loginPanel.hidden = false;
  tokenInput.value = ""; setMessage(loginMessage, "СЕАНС ЗАВЕРШЁН."); tokenInput.focus();
});
async function loadCatalog(showBoot = true) {
  if (showBoot) {
    loginPanel.hidden = true; bootScreen.hidden = false;
    bootCaption.textContent = "СИНХРОНИЗАЦИЯ КАТАЛОГА";
  }
  const data = await api<Catalog>("/api/catalog");
  catalog = data; selectedSlug = catalog.categories[0]?.slug || "";
  if (showBoot) {
    bootCaption.textContent = "СИСТЕМА ГОТОВА";
    await new Promise(resolve => setTimeout(resolve, 650));
    bootScreen.hidden = true;
  }
  workspace.hidden = false; render();
}
$("#toggle-password").addEventListener("click", () => {
  const show = tokenInput.type === "password"; tokenInput.type = show ? "text" : "password";
  $("#toggle-password").textContent = show ? "◎" : "◉";
});
loginForm.addEventListener("submit", async event => {
  event.preventDefault();
  const password = tokenInput.value;
  if (!password) return;
  const submit = $<HTMLButtonElement>("#login-submit");
  submit.disabled = true; setMessage(loginMessage, "СВЯЗЫВАЕМСЯ С СЕРВЕРОМ…");
  try {
    token = password;
    await api("/api/admin/session", { method:"POST", body:JSON.stringify({ token }) });
    loginPanel.hidden = true; bootScreen.hidden = false;
    bootCaption.textContent = "ДОСТУП ПОДТВЕРЖДЁН";
    await new Promise(resolve => setTimeout(resolve, 1100));
    await loadCatalog(true);
  } catch (error) {
    token = ""; bootScreen.hidden = true; loginPanel.hidden = false;
    setMessage(loginMessage, errorText(error) === "Failed to fetch" ? "СЕРВЕР НЕДОСТУПЕН. API ЕЩЁ НЕ ПОДКЛЮЧЁН." : errorText(error), "error");
    tokenInput.select();
  } finally { submit.disabled = false; }
});
</script>
