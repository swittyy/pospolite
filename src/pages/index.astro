---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="POSPOLITE — digital playground" description="Технологии. Пространство. Загадки.">
<div class="loader" id="loader"><strong>POSPOLITE<span>®</span></strong><i></i><small>INITIALIZING / <b>0∞</b></small><div class="cipher">⟟⌁⋔⌖⟊⟒</div></div><canvas id="stars"></canvas><div class="grain"></div><div class="cursor" id="cursor"></div>
<header><a class="brand" href="#">POSPOLITE<sup>®</sup></a><small>AN EXPERIMENTAL PERSONAL SPACE</small><button id="menu">MENU <b>＋</b></button></header><nav id="nav"><a href="#explore">01 / Explore</a><a href="#objects">02 / Objects</a><a href="#about">03 / About</a><button id="terminal-open">⌘ / Terminal</button></nav>
<main><section class="hero"><div class="side">EST. 2026<br>VERSION 0.∞</div><div class="orb-wrap"><div class="orb"><div class="core"></div><i class="ring r1"></i><i class="ring r2"></i><i class="ring r3"></i><small>P / 001</small></div></div><div class="hero-copy"><small class="eyebrow">A PLACE BETWEEN LOGIC AND CURIOSITY</small><h1>Not just<br><em>a website.</em></h1><p>Пространство, которое не спешит<br>объяснять себя.</p><a class="discover" href="#explore">ENTER THE UNKNOWN <span>↘</span></a></div><div class="bottom"><span>SCROLL TO DISCOVER</span><span>55° / 37° / ∞</span></div></section>
<section id="explore" class="section"><label>01 — THE IDEA</label><div class="copy"><h2>Любопытство<br>— это <em>ключ.</em></h2><p>Здесь нет правильного маршрута. Есть поверхности, которые откликаются. Слова, которые ведут дальше. И вещи, которые пока лучше не трогать.</p></div><div class="pulse">✳ <small>KEEP EXPLORING</small></div></section>
<section id="objects" class="section"><label>02 — SMALL WORLDS</label><div class="grid"><a class="tile wide" href="#terminal"><small>A / 001</small><div class="art circles"><i></i><i></i><i></i></div><h3>Signal</h3><p>Найди частоту.</p><span>↗</span></a><a class="tile" href="#about"><small>B / 002</small><div class="art question">?</div><h3>Unknown</h3><p>Непознанное — рядом.</p><span>↗</span></a><a class="tile" href="#terminal"><small>C / 003</small><div class="art bars"><i></i><i></i><i></i><i></i><i></i></div><h3>System</h3><p>Вход для любопытных.</p><span>↗</span></a></div></section>
<section id="about" class="section about"><label>03 — POSPOLITE</label><h2>Built to be<br><em>discovered.</em></h2><p>Персональный цифровой мир. Он будет меняться, хранить открытия и оставлять следы.</p><button id="secret">TRY SOMETHING</button><footer-note>NO MAP. NO RULES. JUST CURIOSITY.</footer-note></section></main><footer><span>POSPOLITE © 2026</span><span>MADE OF QUESTIONS ✳</span><button id="terminal-open2">OPEN TERMINAL ↗</button></footer>
<div class="terminal" id="terminal"><div class="termhead">POSPOLITE / SYSTEM CONSOLE <button id="close">×</button></div><div id="output">shell v0.∞ — type help<br></div><form id="form"><span>›</span><input id="command" autocomplete="off"></form></div>
<style>
:root{--bg:#080909;--fg:#e8e8e4;--dim:#858781;--accent:#c6f36a;--line:#292b29}body{background:var(--bg);color:var(--fg);font-family:Manrope,Arial,sans-serif}html{scroll-behavior:smooth}body:before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 50% 48%,#151918,transparent 60%);pointer-events:none;z-index:-1}header{position:fixed;z-index:10;top:0;width:100%;height:76px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ffffff12;background:#080909b8;backdrop-filter:blur(18px)}.brand{font-weight:800;letter-spacing:-.09em;font-size:21px}.brand sup{font:9px monospace}.headnote,header small,button,.side,.eyebrow,.bottom,label,.tile>small,footer,.termhead{font:10px 'DM Mono',monospace;letter-spacing:.12em;color:var(--dim)}header button{color:var(--fg);border:1px solid var(--line);padding:12px 15px;background:transparent;cursor:pointer}header button b{color:var(--accent);margin-left:15px}nav{position:fixed;z-index:9;right:5vw;top:80px;background:#121414;border:1px solid var(--line);padding:24px;display:grid;gap:20px;min-width:220px;opacity:0;pointer-events:none;transform:translateY(-10px);transition:.3s}nav.open{opacity:1;transform:none;pointer-events:auto}nav a,nav button{font:12px monospace;color:var(--fg);background:none;border:0;text-align:left;cursor:pointer}.hero{min-height:100svh;position:relative;overflow:hidden;padding:110px 5vw 35px;display:flex;flex-direction:column;justify-content:space-between}.side{position:absolute;left:5vw;top:29%;line-height:1.8}.orb-wrap{position:absolute;right:7%;top:14%;width:min(53vw,680px);height:min(75vh,680px);display:grid;place-items:center;perspective:1000px}.orb{width:min(43vw,510px);aspect-ratio:1;position:relative;animation:float 8s ease-in-out infinite}.orb:before{content:'';position:absolute;inset:13%;border-radius:50%;background:radial-gradient(circle at 35% 28%,#e1f5b7,#9fbf69 8%,#465d3b 28%,#1b2721 52%,#0c1010 68%);box-shadow:inset -30px -40px 70px #000c,0 0 90px #a9e95b22}.ring{position:absolute;border:1px solid #b5d77965;border-radius:50%;inset:3%;transform:rotateX(67deg) rotateZ(-28deg)}.r2{inset:-9%;transform:rotateX(68deg) rotateZ(45deg);border-color:#e8e8e440}.r3{inset:18%;transform:rotateY(65deg) rotateZ(20deg)}.core{position:absolute;inset:40%;border-radius:50%;background:var(--accent);box-shadow:0 0 60px 20px #c6f36a40;animation:glow 4s infinite alternate}.orb small{position:absolute;right:8%;bottom:9%;color:var(--accent);font:10px monospace}.hero-copy{position:relative;z-index:2;margin-top:10vh}.eyebrow{color:var(--accent)}h1{font-size:clamp(65px,10.5vw,145px);letter-spacing:-.09em;line-height:.91;font-weight:650;margin:28px 0}h1 em,h2 em{font-weight:400;color:transparent;-webkit-text-stroke:1px #e7e7e4;font-style:normal}.hero-copy p,.section p{color:#a5a7a0;font-size:14px;line-height:1.8;margin-top:32px}.discover{display:flex;justify-content:space-between;width:230px;border-bottom:1px solid #62655d;padding:16px 0;margin-top:38px;font:10px monospace;transition:.3s}.discover span{color:var(--accent);font-size:20px}.discover:hover{width:270px;color:var(--accent)}.bottom{display:flex;justify-content:space-between;font:10px monospace;color:var(--dim)}.section{padding:130px 5vw;border-top:1px solid var(--line);position:relative}.copy{margin:80px 0 40px auto;max-width:780px}h2{font-size:clamp(50px,8vw,112px);letter-spacing:-.075em;line-height:.98;font-weight:600;margin:0}.copy h2 em{color:var(--accent);-webkit-text-stroke:0}.copy p{max-width:440px}.pulse{color:var(--accent);font-size:32px;margin-top:60px}.pulse small{font:10px monospace;color:var(--dim)}.grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:14px;margin-top:65px}.tile{min-height:330px;border:1px solid var(--line);padding:25px;position:relative;overflow:hidden;background:#101211;transition:transform .2s,border .3s}.tile:hover{border-color:#a7ce6a}.tile.wide{min-height:430px}.tile h3{font-size:28px;letter-spacing:-.06em;position:absolute;bottom:45px}.tile p{position:absolute;bottom:20px;font-size:11px}.tile>span{position:absolute;right:24px;bottom:30px;color:var(--accent)}.art{position:absolute;inset:15% 10%;display:grid;place-items:center}.circles i{position:absolute;border:1px solid #d0ef8a80;border-radius:50%;width:70%;aspect-ratio:1}.circles i:nth-child(2){width:50%;transform:rotateX(60deg)}.circles i:nth-child(3){width:90%;transform:rotateY(60deg)}.question{font-size:clamp(100px,18vw,230px);font-weight:200;color:#c6f36a15}.bars{display:flex;align-items:center;gap:8px}.bars i{width:10%;height:35%;background:var(--accent);opacity:.4;animation:bars 1.5s infinite alternate}.bars i:nth-child(2){height:70%}.bars i:nth-child(3){height:100%}.bars i:nth-child(4){height:50%}.bars i:nth-child(5){height:80%}.about h2{margin:65px 0}.about>p{max-width:450px}.about button{border:1px solid var(--line);background:none;color:var(--fg);padding:14px 20px;margin-top:25px;cursor:pointer}.about button:hover{border-color:var(--accent);color:var(--accent)}footer-note{display:block;margin-top:120px;font:10px monospace;color:var(--dim)}footer{padding:28px 5vw;display:flex;justify-content:space-between;border-top:1px solid var(--line);align-items:center}footer button{background:none;border:0;cursor:pointer}.cursor{position:fixed;width:9px;height:9px;border-radius:50%;background:var(--accent);z-index:20;pointer-events:none;mix-blend-mode:difference}.grain{position:fixed;inset:0;pointer-events:none;z-index:4;opacity:.045;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.6'/%3E%3C/svg%3E")}.terminal{position:fixed;z-index:30;left:50%;top:50%;width:min(600px,92vw);transform:translate(-50%,-50%);background:#0e1110;border:1px solid #50584b;box-shadow:0 30px 100px #000a;padding:20px;display:none;font:12px monospace;color:var(--accent)}.terminal.show{display:block}.termhead{display:flex;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid var(--line)}.termhead button{background:none;color:var(--fg);border:0;font-size:22px;cursor:pointer}#output{min-height:170px;max-height:45vh;overflow:auto;line-height:1.8;color:#d0d2c8;padding:16px 0}#form{display:flex;gap:10px;border-top:1px solid var(--line);padding-top:14px}#form input{background:transparent;border:0;outline:0;color:var(--accent);font:12px monospace;flex:1}.loader{position:fixed;z-index:50;inset:0;background:#080909;display:flex;flex-direction:column;justify-content:center;align-items:center;transition:opacity .7s}.loader.done{opacity:0;pointer-events:none}.loader strong{font-size:clamp(24px,5vw,50px);letter-spacing:-.1em}.loader strong span{font:10px monospace;vertical-align:top}.loader i{width:170px;height:1px;background:var(--accent);margin:35px 0;animation:loading 2s ease forwards}.loader small{font:8px monospace;color:var(--dim)}.cipher{margin-top:25px;color:#777;font:12px monospace;animation:blink 1s infinite}#stars{position:absolute;inset:0;pointer-events:none;opacity:.35}@keyframes float{50%{transform:translateY(-15px) rotate(4deg)}}@keyframes glow{to{opacity:.5;transform:scale(.75)}}@keyframes bars{to{transform:scaleY(.2)}}@keyframes loading{from{width:0}to{width:170px}}@keyframes blink{50%{opacity:.2}}@media(max-width:760px){header{height:64px}header small{display:none}.hero{padding-top:100px;min-height:100svh}.orb-wrap{width:90vw;height:50vh;right:-12%;top:20%;opacity:.75}.orb{width:70vw}.side{top:20%;font-size:8px}.hero-copy{margin-top:16vh}h1{font-size:clamp(62px,18vw,105px)}.hero-copy p{font-size:12px}.bottom{font-size:8px}.section{padding:90px 6vw}.copy{margin:65px 0}.grid{grid-template-columns:1fr}.tile,.tile.wide{min-height:300px}.about h2{margin:50px 0}footer-note{margin-top:80px}footer{font-size:8px;gap:12px;flex-wrap:wrap}}
</style>
<script>
const loader=document.getElementById('loader');setTimeout(()=>loader.classList.add('done'),2200);const menu=document.getElementById('menu'),nav=document.getElementById('nav');menu.onclick=()=>nav.classList.toggle('open');nav.querySelectorAll('a').forEach(a=>a.onclick=()=>nav.classList.remove('open'));const cursor=document.getElementById('cursor');addEventListener('pointermove',e=>{cursor.style.left=e.clientX+'px';cursor.style.top=e.clientY+'px'});const term=document.getElementById('terminal'),out=document.getElementById('output'),input=document.getElementById('command');function openTerm(){term.classList.add('show');input.focus()}document.getElementById('terminal-open').onclick=openTerm;document.getElementById('terminal-open2').onclick=openTerm;document.getElementById('close').onclick=()=>term.classList.remove('show');document.getElementById('secret').onclick=()=>{document.body.style.setProperty('--accent','#ff8c70');setTimeout(()=>document.body.style.setProperty('--accent','#c6f36a'),1600);openTerm()};document.getElementById('form').onsubmit=e=>{e.preventDefault();let c=input.value.trim().toLowerCase();input.value='';out.innerHTML+='› '+c+'<br>';let a={help:'help, about, clear, time, echo, secret, matrix',about:'A little corner of POSPOLITE.',time:new Date().toLocaleString(),secret:'Signal detected. Look behind the surface.',matrix:'01010000 01001111 01010011 01010000 01001111 01001100 01001001 01010100 01000101'};if(c==='clear')out.innerHTML='';else out.innerHTML+=(a[c]||'unknown command. Try help.')+'<br>';out.scrollTop=out.scrollHeight};let taps=0;document.querySelector('.brand').onclick=e=>{e.preventDefault();if(++taps===5){openTerm();taps=0}};document.querySelectorAll('.tile').forEach(el=>{el.onpointermove=e=>{if(innerWidth<760)return;let r=el.getBoundingClientRect();el.style.transform='perspective(700px) rotateX('+((r.top+r.height/2-e.clientY)/r.height*7)+'deg) rotateY('+((e.clientX-r.left-r.width/2)/r.width*7)+'deg)'};el.onpointerleave=()=>el.style.transform=''});const canvas=document.getElementById('stars'),ctx=canvas.getContext('2d');let s=[];function resize(){canvas.width=innerWidth;canvas.height=innerHeight;s=Array.from({length:100},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,r:Math.random()*1.2,v:Math.random()*.25}))}function draw(){ctx.clearRect(0,0,canvas.width,canvas.height);s.forEach(p=>{p.y-=p.v;if(p.y<0)p.y=canvas.height;ctx.fillStyle='#d8e7b8';ctx.globalAlpha=.3;ctx.fillRect(p.x,p.y,p.r,p.r)});requestAnimationFrame(draw)}resize();draw();onresize=resize;let seq=[];addEventListener('keydown',e=>{seq.push(e.key.toLowerCase());seq=seq.slice(-5);if(seq.join('')==='ghost'){document.body.style.filter='hue-rotate(90deg)';setTimeout(()=>document.body.style.filter='',2500)}});
</script>
</SiteLayout>